# Copy this file to "keystore.properties" (same folder) and fill it in.
# keystore.properties is git-ignored: never commit it or the .jks file.
# Use forward slashes in the path, also on Windows.
storeFile=C:/Users/YOUR_USER/android-build/keys/relics-upload.jks
storePassword=YOUR_PASSWORD
keyAlias=relics-upload
keyPassword=YOUR_PASSWORD
